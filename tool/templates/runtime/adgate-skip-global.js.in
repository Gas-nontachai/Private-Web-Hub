(() => {
  const skipButtonSelector = __SKIP_SELECTOR__;
  const clickedButtons = new WeakSet();
  let previousButtons = new Set();

__VISIBILITY__
__SKIP_TARGETS__
  function resetDetachedButtons(node) {
    if (!(node instanceof Element)) {
      return;
    }

    if (node.matches(skipButtonSelector) && !node.isConnected) {
      clickedButtons.delete(node);
    }
    for (const button of node.querySelectorAll(skipButtonSelector)) {
      if (!button.isConnected) {
        clickedButtons.delete(button);
      }
    }
  }

  function checkSkipButtons() {
    const buttons = new Set(findSkipButtons(skipButtonSelector));
    for (const button of previousButtons) {
      if (!buttons.has(button)) clickedButtons.delete(button);
    }
    previousButtons = buttons;
    for (const button of buttons) {
      if (!isVisible(button)) {
        clickedButtons.delete(button);
        continue;
      }

      if (!clickedButtons.has(button)) {
        clickedButtons.add(button);
        try {
          const container = button.closest?.('.jwplayer.jw-flag-ads');
          const player = container && typeof window.jwplayer === 'function' ? window.jwplayer(container.id) : null;
          if (typeof player?.skipAd === 'function') player.skipAd();
          else button.click();
        } catch (_) { button.click(); }
      }
    }
  }

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "hidden" &&
        mutation.target instanceof Element &&
        (mutation.oldValue !== null || mutation.target.hasAttribute("hidden"))
      ) {
        clickedButtons.delete(mutation.target);
      }

      for (const removedNode of mutation.removedNodes) {
        resetDetachedButtons(removedNode);
      }
    }
    checkSkipButtons();
  });

  observer.observe(document, {
    attributes: true,
    attributeOldValue: true,
    childList: true,
    subtree: true
  });

  checkSkipButtons();
})();
