// Keep Animeruka's catalog hide rules applied when ads are inserted or
// re-shown after the document starts loading.
(() => {
  const selectors = __HIDE_SELECTORS__;
  const selector = selectors.join(",");
  const hide = (element) => {
    if (
      element.style.getPropertyValue("display") !== "none" ||
      element.style.getPropertyPriority("display") !== "important"
    ) {
      element.style.setProperty("display", "none", "important");
    }
  };
  const hideSubtree = (element) => {
    if (!element || element.nodeType !== 1) return;
    if (element.matches(selector)) hide(element);
    element.querySelectorAll(selector).forEach(hide);
  };

  const apply = () => document.querySelectorAll(selector).forEach(hide);
  apply();
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === "childList") {
        mutation.addedNodes.forEach(hideSubtree);
      } else {
        hideSubtree(mutation.target);
      }
    }
  });
  observer.observe(document.documentElement || document, {
    attributes: true,
    attributeFilter: ["style", "class", "id"],
    childList: true,
    subtree: true,
  });
})();
