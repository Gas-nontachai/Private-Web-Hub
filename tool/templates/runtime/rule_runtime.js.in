// Reviewed, bundled runtime. Interprets declarative rules only; never evals remote code.
// The rules token below is replaced with the validated JSON array of enabled rules.
(() => {
  const rules = __RULES__;
  const host = location.hostname;
  const MAX_SELECTOR_LENGTH = 200;

  let parentHost = "";
  try {
    parentHost = new URL(document.referrer).hostname;
  } catch (_) {}

  const active = rules.filter(
    (r) =>
      (r.hosts.includes("*") || r.hosts.includes(host)) &&
      (!r.parentHosts || r.parentHosts.includes(parentHost))
  );
  if (active.length === 0) return;

  const state = (window.__mvRules = window.__mvRules || {
    styles: {},
    observers: {},
    clicked: new WeakSet(),
  });

  const tapHosts = new Set();
  for (const r of rules) {
    if (r.actions.some((a) => a.type === "tapWhenVisible")) {
      r.hosts.forEach((h) => tapHosts.add(h));
    }
  }

  const pendingTaps = new Map();
  let tapId = 0;
  const validRect = (r) => r && [r.x, r.y, r.w, r.h].every(Number.isFinite) && r.w > 0 && r.h > 0;
  const inViewport = (r, width = window.innerWidth, height = window.innerHeight) =>
    validRect(r) && r.x + r.w / 2 >= 0 && r.y + r.h / 2 >= 0 &&
    r.x + r.w / 2 < width && r.y + r.h / 2 < height;

  // Every parent checks visibility and transforms coordinates before acknowledging a real tap.
  const relay = async (rect) => {
    if (!inViewport(rect)) return false;
    if (window === window.top) {
      const handler = window.flutter_inappwebview;
      if (!handler || typeof handler.callHandler !== 'function') return false;
      try {
        return await handler.callHandler("mvTap", rect.x + rect.w / 2, rect.y + rect.h / 2, window.innerWidth) === true;
      } catch (_) { return false; }
    }
    const id = ++tapId;
    return new Promise((resolve) => {
      const timer = setTimeout(() => { pendingTaps.delete(id); resolve(false); }, 2000);
      pendingTaps.set(id, (ok) => { clearTimeout(timer); resolve(ok); });
      window.parent.postMessage({ __mvTap: true, id, rect, width: window.innerWidth, height: window.innerHeight }, '*');
    });
  };

  if (!state.listening) {
    state.listening = true;
    window.addEventListener('message', async (e) => {
      const d = e.data;
      if (!d) return;
      if (d.__mvTapResult === true && e.source === window.parent) {
        const done = pendingTaps.get(d.id);
        if (done) { pendingTaps.delete(d.id); done(d.ok === true); }
        return;
      }
      if (d.__mvTap !== true || !Number.isInteger(d.id) || !validRect(d.rect) ||
          !Number.isFinite(d.width) || !Number.isFinite(d.height) || d.width <= 0 || d.height <= 0) return;
      let originHost = '';
      try { originHost = new URL(e.origin).hostname; } catch (_) {}
      if (!tapHosts.has('*') && !tapHosts.has(originHost)) return;
      for (const frame of document.querySelectorAll('iframe')) {
        if (frame.contentWindow !== e.source) continue;
        let ok = false;
        if (isVisible(frame) && inViewport(d.rect, d.width, d.height)) {
          const bounds = frame.getBoundingClientRect();
          const scaleX = bounds.width / frame.offsetWidth;
          const scaleY = bounds.height / frame.offsetHeight;
          const rect = {
            x: bounds.left + (frame.clientLeft + d.rect.x * frame.clientWidth / d.width) * scaleX,
            y: bounds.top + (frame.clientTop + d.rect.y * frame.clientHeight / d.height) * scaleY,
            w: d.rect.w * frame.clientWidth / d.width * scaleX,
            h: d.rect.h * frame.clientHeight / d.height * scaleY,
          };
          const hit = document.elementFromPoint(rect.x + rect.w / 2, rect.y + rect.h / 2);
          if (hit === frame) ok = await relay(rect);
        }
        e.source.postMessage({ __mvTapResult: true, id: d.id, ok }, e.origin === 'null' ? '*' : e.origin);
        return;
      }
    });
  }

  const validSelector = (s) => {
    if (typeof s !== "string" || s.length > MAX_SELECTOR_LENGTH) return false;
    try {
      document.createDocumentFragment().querySelector(s);
      return true;
    } catch (_) {
      return false;
    }
  };

__VISIBILITY__
__SKIP_TARGETS__
  for (const rule of active) {
    for (const action of rule.actions) {
      const selectors = (action.selectors || []).filter(validSelector);
      if (selectors.length === 0) continue;

      if (action.type === "hide") {
        const key = rule.id;
        if (state.styles[key] && state.styles[key].isConnected) continue;
        const style = document.createElement("style");
        style.dataset.mvRule = key;
        style.textContent = selectors.join(",\n") + " { display: none !important; }";
        (document.head || document.documentElement).appendChild(style);
        state.styles[key] = style;

        const selector = selectors.join(",");
        const hide = (element) => {
          if (
            element.style.getPropertyValue("display") !== "none" ||
            element.style.getPropertyPriority("display") !== "important"
          ) {
            element.style.setProperty("display", "none", "important");
          }
        };
        const hideSubtree = (element) => {
          if (!element || element.nodeType !== 1) return;
          if (element.matches(selector)) hide(element);
          element.querySelectorAll(selector).forEach(hide);
        };
        document.querySelectorAll(selector).forEach(hide);
        const observerKey = `${key}:hide`;
        if (!state.observers[observerKey]) {
          const observer = new MutationObserver((mutations) => {
            for (const mutation of mutations) {
              if (mutation.type === "childList") {
                mutation.addedNodes.forEach(hideSubtree);
              } else {
                hideSubtree(mutation.target);
              }
            }
          });
          observer.observe(document.documentElement || document, {
            attributes: true,
            attributeFilter: ["style", "class", "id"],
            childList: true,
            subtree: true,
          });
          state.observers[observerKey] = observer;
        }
      } else if (action.type === "tapWhenVisible") {
        // Some players ignore synthetic clicks (isTrusted), so ask the host app for a real tap.
        const key = rule.id;
        if (state.observers[key]) continue;
        let target = null;
        let taps = 0;
        let busy = false;
        const timer = setInterval(async () => {
          if (busy) return;
          const el = findSkipButtons(selectors.join(',')).find(isVisible);
          if (el !== target) { target = el; taps = 0; }
          if (!el || taps >= 12) return;
          const bounds = el.getBoundingClientRect();
          const rect = { x: bounds.left, y: bounds.top, w: bounds.width, h: bounds.height };
          if (!inViewport(rect)) return;
          const hit = document.elementFromPoint(rect.x + rect.w / 2, rect.y + rect.h / 2);
          if (hit !== el && !el.contains(hit)) return;
          busy = true;
          try { if (await relay(rect)) taps++; }
          finally { busy = false; }
        }, 1500);
        state.observers[key] = { disconnect: () => clearInterval(timer) };
      } else if (action.type === "clickWhenVisible") {
        const key = rule.id;
        if (state.observers[key]) continue;
        const check = () => {
          for (const sel of selectors) {
            for (const el of document.querySelectorAll(sel)) {
              if (!isVisible(el)) {
                state.clicked.delete(el);
              } else if (!state.clicked.has(el)) {
                state.clicked.add(el);
                el.click();
              }
            }
          }
        };
        const observer = new MutationObserver(check);
        observer.observe(document, {
          attributes: true,
          childList: true,
          subtree: true,
        });
        state.observers[key] = observer;
        check();
      }
    }
  }
})();
