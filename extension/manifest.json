{
  "manifest_version": 3,
  "name": "Movie.exe",
  "version": "1.0.0",
  "description": "Hide advertisements on supported websites",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.serieday-z.com/*",
        "http://www.serieday-z.com/*"
      ],
      "css": [
        "rules/serieday.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.037-hdd.com/*",
        "http://www.037-hdd.com/*"
      ],
      "css": [
        "rules/037hdd.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://goseries4k.com/*",
        "http://goseries4k.com/*",
        "https://www.goseries4k.com/*",
        "http://www.goseries4k.com/*"
      ],
      "css": [
        "rules/goseries4k.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://movie2freehd.com/*",
        "http://movie2freehd.com/*"
      ],
      "css": [
        "rules/movie2freehd.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://animeruka.com/*",
        "http://animeruka.com/*"
      ],
      "css": [
        "rules/animeruka.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "js": [
        "content/animeruka-hide-ads.js"
      ]
    },
    {
      "matches": [
        "https://youtube.com/*",
        "http://youtube.com/*",
        "https://www.youtube.com/*",
        "http://www.youtube.com/*",
        "https://m.youtube.com/*",
        "http://m.youtube.com/*"
      ],
      "css": [
        "rules/youtube.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content/adgate-skip-global.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "adguard/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "adguard/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest",
    "cookies",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_2",
        "enabled": false,
        "path": "adguard/filters/declarative/ruleset_2/ruleset_2.json"
      },
      {
        "id": "ruleset_3",
        "enabled": false,
        "path": "adguard/filters/declarative/ruleset_3/ruleset_3.json"
      },
      {
        "id": "ruleset_11",
        "enabled": false,
        "path": "adguard/filters/declarative/ruleset_11/ruleset_11.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "web-accessible-resources/redirects/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
